APP_ENV=local
TRANSLATION_PROVIDER=local
# GOOGLE_TRANSLATE_API_KEY=replace-with-a-local-secret
LLM_PROVIDER=ollama
# OPENAI_API_KEY=replace-with-a-local-secret
OPENAI_MODEL=gpt-5.6-terra

HADOOP_IMAGE=apache/hadoop:3.4.1
SPARK_IMAGE=apache/spark:3.5.5
CHROMA_IMAGE=chromadb/chroma:0.5.23
OLLAMA_IMAGE=ollama/ollama:0.11.10

SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

HDFS_NAMENODE_UI_PORT=9870
HDFS_NAMENODE_RPC_PORT=9000
HDFS_DATANODE_1_UI_PORT=9864
HDFS_DATANODE_2_UI_PORT=9865
SPARK_MASTER_UI_PORT=18080
SPARK_MASTER_PORT=7077
SPARK_WORKER_1_UI_PORT=18081
SPARK_WORKER_2_UI_PORT=18082
CHROMA_PORT=8000
OLLAMA_PORT=11434
STREAMLIT_PORT=8501
